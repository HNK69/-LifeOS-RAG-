# ============================================================
# LifeOS Production Environment Template (.env.example)
# Copy to .env and configure all required production values.
# ============================================================

# Environment: "development", "testing", "staging", or "production"
LIFEOS_API_ENVIRONMENT=production

# Server Network Configuration
LIFEOS_API_HOST=0.0.0.0
LIFEOS_API_PORT=8000
# IMPORTANT: LifeOS single-node architecture requires exactly 1 worker.
LIFEOS_API_WORKERS=1

# Production Authentication (Strictly required in production)
LIFEOS_API_AUTH_ENABLED=true
# Minimum 16 characters secret API keys (MUST BE DISTINCT)
LIFEOS_API_KEY=replace_with_strong_random_client_key_at_least_16_chars
LIFEOS_API_ADMIN_KEY=replace_with_strong_random_admin_key_at_least_16_chars

# OpenRouter LLM Credentials (Required)
OPENROUTER_API_KEY=sk-or-v1-replace_with_your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001

# Rate Limiting (Requests per sliding window)
LIFEOS_API_RATE_LIMIT=60
LIFEOS_API_RATE_WINDOW_SECONDS=60

# Resource Boundaries
LIFEOS_API_MAX_REQUEST_BYTES=10485760
LIFEOS_API_MAX_QUERY_LENGTH=4096

# Network Security Boundaries (Disallow wildcard '*' in production)
LIFEOS_API_CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
LIFEOS_API_TRUSTED_HOSTS=app.yourdomain.com,api.yourdomain.com,127.0.0.1,localhost
LIFEOS_API_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
LIFEOS_API_ALLOWED_HEADERS=Authorization,X-API-Key,X-Session-ID,X-Request-ID,Content-Type

# Storage Paths
LIFEOS_DATA_DIR=/app/data
LIFEOS_DOCUMENTS_DIR=/app/data/documents
LIFEOS_CHROMA_DIR=/app/chroma_db
LIFEOS_BACKUP_DIR=/app/data/backups

# Operations & Observability
LIFEOS_LOG_FORMAT=json
LIFEOS_API_LOG_REQUESTS=true
LIFEOS_METRICS_ENABLED=true
LIFEOS_WATCHER_ENABLED=false
